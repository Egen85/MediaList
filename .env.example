# copy this to .env and fill it in — never commit the real .env
# TMDB v3 API key: themoviedb.org → Account → API → "API v3 key" (keys don't expire)
TMDB_API_KEY=PASTE_YOUR_TMDB_API_KEY_HERE
# the one password that unlocks the admin corner (top-right)
ADMIN_PASSWORD=changeme
# listen port (any free port works)
PORT=4179
